{
  "name": "key-wrong-environment",
  "summary": "A key of the other environment (a production key on staging, or the other way round).",
  "app": {
    "status": "Ready",
    "require_verified_identity": true,
    "platforms": {
      "android": {
        "transport": "fcm"
      },
      "ios": {
        "transport": "apns"
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/v1/config",
        "headers": {
          "X-DataTalks-App-Key": "{{app_key:other_environment}}",
          "X-DataTalks-SDK": "datatalks-push-android/0.1.0-alpha"
        }
      },
      "response": {
        "status": 401,
        "body": {
          "error": {
            "code": "key_wrong_environment",
            "message": "{{any}}"
          }
        }
      }
    }
  ]
}
