{
  "name": "register-token-transport-mismatch",
  "summary": "An APNs token on Android.",
  "app": {
    "status": "Ready",
    "require_verified_identity": true,
    "platforms": {
      "android": {
        "transport": "fcm"
      },
      "ios": {
        "transport": "apns"
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/devices",
        "headers": {
          "X-DataTalks-App-Key": "{{app_key}}",
          "X-DataTalks-SDK": "datatalks-push-android/0.1.0-alpha"
        },
        "body": {
          "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
          "platform": "android",
          "apns_token": "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90"
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "code": "platform_mismatch",
            "message": "{{any}}"
          }
        }
      }
    }
  ]
}
