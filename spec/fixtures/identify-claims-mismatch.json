{
  "name": "identify-claims-mismatch",
  "summary": "The body external id differs from the token sub.",
  "app": {
    "status": "Ready",
    "require_verified_identity": true,
    "platforms": {
      "android": {
        "transport": "fcm"
      },
      "ios": {
        "transport": "apns"
      }
    }
  },
  "identity_tokens": {
    "member_1001": {
      "sub": "member-1001",
      "email": "anna@example.com",
      "expires_in_seconds": 300
    },
    "member_1001_expired": {
      "sub": "member-1001",
      "expires_in_seconds": -300
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/devices",
        "headers": {
          "X-DataTalks-App-Key": "{{app_key}}",
          "X-DataTalks-SDK": "datatalks-push-android/0.1.0-alpha"
        },
        "body": {
          "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
          "platform": "android",
          "fcm_token": "cXa1B2c3D4e5F6g7H8i9J0",
          "fcm_token_type": "fcm_fid",
          "os_permission": "authorized",
          "app_version": "4.12.0",
          "app_build": "4120",
          "os_version": "15",
          "device_manufacturer": "Google",
          "device_model": "Pixel 8",
          "locale": "sv-SE",
          "time_zone": "Europe/Stockholm"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
          "device_secret": "{{capture:device_secret}}"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/devices/3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f/identify",
        "headers": {
          "X-DataTalks-App-Key": "{{app_key}}",
          "X-DataTalks-SDK": "datatalks-push-android/0.1.0-alpha",
          "X-DataTalks-Device-Secret": "{{device_secret}}"
        },
        "body": {
          "external_id": "member-2002",
          "identity_token": "{{token:member_1001}}"
        }
      },
      "response": {
        "status": 401,
        "body": {
          "error": {
            "code": "identity_token_invalid",
            "message": "{{any}}",
            "detail": "claims_mismatch"
          }
        }
      }
    }
  ]
}
