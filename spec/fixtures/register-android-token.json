{
  "name": "register-android-token",
  "summary": "First launch on Android, in an app without FID registration: a new install registers its registration token.",
  "app": {
    "status": "Ready",
    "require_verified_identity": true,
    "platforms": {
      "android": {
        "transport": "fcm"
      },
      "ios": {
        "transport": "apns"
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/devices",
        "headers": {
          "X-DataTalks-App-Key": "{{app_key}}",
          "X-DataTalks-SDK": "datatalks-push-android/0.1.0-alpha"
        },
        "body": {
          "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
          "platform": "android",
          "fcm_token": "cXa1B2c3D4e5F6g7H8i9J0:APA91bFIXTURE-registration-token-sample",
          "fcm_token_type": "fcm_token",
          "os_permission": "authorized",
          "app_version": "4.12.0",
          "app_build": "4120",
          "os_version": "15",
          "device_manufacturer": "Google",
          "device_model": "Pixel 8",
          "locale": "sv-SE",
          "time_zone": "Europe/Stockholm"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
          "device_secret": "{{capture:device_secret}}"
        }
      }
    }
  ]
}
