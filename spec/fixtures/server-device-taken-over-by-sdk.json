{
  "name": "server-device-taken-over-by-sdk",
  "summary": "The SDK registers the FID of a token the backend sent and takes that device over; later sends and deletes of that token, and a send or delete naming the SDK install by its id, are skipped.",
  "app": {
    "status": "Ready",
    "require_verified_identity": true,
    "platforms": {
      "android": {
        "transport": "fcm"
      },
      "ios": {
        "transport": "apns"
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "PUT",
        "path": "/v1/server/devices",
        "headers": {
          "X-DataTalks-Server-Key": "{{server_key}}"
        },
        "body": {
          "devices": [
            {
              "platform": "android",
              "fcm_token": "cXa1B2c3D4e5F6g7H8i9J0:APA91bFIXTURE-registration-token-sample",
              "external_id": "member-1001"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "index": 0,
              "install_id": "{{uuid}}",
              "result": "created"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/devices",
        "headers": {
          "X-DataTalks-App-Key": "{{app_key}}",
          "X-DataTalks-SDK": "datatalks-push-android/0.1.0-alpha"
        },
        "body": {
          "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
          "platform": "android",
          "fcm_token": "cXa1B2c3D4e5F6g7H8i9J0",
          "fcm_token_type": "fcm_fid",
          "os_permission": "authorized",
          "app_version": "4.12.0",
          "app_build": "4120",
          "os_version": "15",
          "device_manufacturer": "Google",
          "device_model": "Pixel 8",
          "locale": "sv-SE",
          "time_zone": "Europe/Stockholm"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
          "device_secret": "{{capture:device_secret}}"
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/v1/server/devices",
        "headers": {
          "X-DataTalks-Server-Key": "{{server_key}}"
        },
        "body": {
          "devices": [
            {
              "platform": "android",
              "fcm_token": "cXa1B2c3D4e5F6g7H8i9J0:APA91bFIXTURE-registration-token-sample",
              "external_id": "member-1001"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "index": 0,
              "install_id": "{{uuid}}",
              "result": "skipped",
              "reason": "taken_over_by_sdk"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "PUT",
        "path": "/v1/server/devices",
        "headers": {
          "X-DataTalks-Server-Key": "{{server_key}}"
        },
        "body": {
          "devices": [
            {
              "platform": "android",
              "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
              "fcm_token": "eFixture2345:APA91bFIXTURE-registration-token-second"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "index": 0,
              "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f",
              "result": "skipped",
              "reason": "taken_over_by_sdk"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/server/devices/delete",
        "headers": {
          "X-DataTalks-Server-Key": "{{server_key}}"
        },
        "body": {
          "devices": [
            {
              "platform": "android",
              "fcm_token": "cXa1B2c3D4e5F6g7H8i9J0:APA91bFIXTURE-registration-token-sample"
            },
            {
              "install_id": "3f1c2d4e-5a6b-4c7d-8e9f-0a1b2c3d4e5f"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "results": [
            {
              "index": 0,
              "result": "skipped",
              "reason": "taken_over_by_sdk"
            },
            {
              "index": 1,
              "result": "skipped",
              "reason": "taken_over_by_sdk"
            }
          ]
        }
      }
    }
  ]
}
