              "occurred_at": "2026-11-04T11:00:02Z"
            },
            {
              "event_id": "6bcf9a8c-7d0e-4f1a-8b2c-3d4e5f6a7b8c",
              "type": "delivery",
              "uid": "6e1f8a2b-3c4d-4e5f-9a0b-1c2d3e4f5a6b",
              "occurred_at": "2026-11-04T11:00:02Z"
            },
            {
              "event_id": "7cd0ab9d-8e1f-4a2b-9c3d-4e5f6a7b8c9d",
              "type": "open",
              "uid": "{{uid:offer}}",
              "occurred_at": "2026-11-04T11:30:00Z",
              "link": "https://example.com/offer"
            },
            {
              "event_id": "8de1bcae-9f2a-4b3c-8d4e-5f6a7b8c9d0e",
              "type": "open",
              "uid": "{{uid:early}}",
              "occurred_at": "2026-11-04T09:00:00Z"
            }
          ]
        }
      },
      "response": {
        "status": 202,
        "body": {
          "results": [
            { "index": 0, "result": "accepted" },
            { "index": 1, "result": "duplicate" },
            { "index": 2, "result": "skipped", "reason": "message_unknown" },
            { "index": 3, "result": "skipped", "reason": "message_unknown" },
            { "index": 4, "result": "skipped", "reason": "invalid_field", "field": "link" },
            { "index": 5, "result": "accepted" }
          ]
        }
      }
    }
  ]
}
