{
  "name": "register-platform-not-set-up",
  "summary": "An iOS registration for an app set up only for Android.",
  "app": {
    "status": "Ready",
    "require_verified_identity": true,
    "platforms": {
      "android": {
        "transport": "fcm"
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/devices",
        "headers": {
          "X-DataTalks-App-Key": "{{app_key}}",
          "X-DataTalks-SDK": "datatalks-push-ios/0.1.0-alpha"
        },
        "body": {
          "install_id": "7d2e9a10-4b3c-4f5e-9a8b-1c2d3e4f5a6b",
          "platform": "ios",
          "apns_token": "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90",
          "os_permission": "authorized"
        }
      },
      "response": {
        "status": 400,
        "body": {
          "error": {
            "code": "platform_mismatch",
            "message": "{{any}}"
          }
        }
      }
    }
  ]
}
