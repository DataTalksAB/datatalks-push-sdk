{
  "name": "register-ios-sandbox",
  "summary": "A development build on iOS registers its APNs token with the sandbox environment.",
  "app": {
    "status": "Ready",
    "require_verified_identity": true,
    "platforms": {
      "android": {
        "transport": "fcm"
      },
      "ios": {
        "transport": "apns"
      }
    }
  },
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/devices",
        "headers": {
          "X-DataTalks-App-Key": "{{app_key}}",
          "X-DataTalks-SDK": "datatalks-push-ios/0.1.0-alpha"
        },
        "body": {
          "install_id": "7d2e9a10-4b3c-4f5e-9a8b-1c2d3e4f5a6b",
          "platform": "ios",
          "environment": "sandbox",
          "apns_token": "a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90",
          "os_permission": "provisional",
          "app_version": "4.12.0",
          "app_build": "981",
          "os_version": "18.1",
          "device_manufacturer": "Apple",
          "device_model": "iPhone16,1",
          "locale": "sv-SE",
          "time_zone": "Europe/Stockholm"
        }
      },
      "response": {
        "status": 201,
        "body": {
          "install_id": "7d2e9a10-4b3c-4f5e-9a8b-1c2d3e4f5a6b",
          "device_secret": "{{capture:device_secret}}"
        }
      }
    }
  ]
}
